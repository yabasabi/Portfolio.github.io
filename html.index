/* ตั้งค่าพื้นฐานของเว็บไซต์ */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: "Tahoma", "Arial", sans-serif;
    background: linear-gradient(135deg, #f8f1ff, #fff5fa);
    color: #333;
    line-height: 1.8;
}

/* ส่วนหัว */
header {
    background: linear-gradient(135deg, #8e44ad, #d63384);
    color: white;
    text-align: center;
    padding: 70px 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

header h1 {
    font-size: 40px;
    margin-bottom: 10px;
}

header p {
    font-size: 20px;
}

/* ส่วนเนื้อหาหลัก */
section {
    max-width: 900px;
    margin: 45px auto;
    padding: 35px;
}

/* หัวข้อ */
h2 {
    color: #8e44ad;
    font-size: 30px;
    margin-bottom: 20px;
    text-align: center;
}

/* เกี่ยวกับตัวเอง */
#about {
    background: white;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

#about p {
    text-align: center;
    font-size: 18px;
}

/* ผลงาน */
#projects {
    background: transparent;
}

.project {
    background: white;
    padding: 25px;
    margin: 20px 0;
    border-radius: 18px;
    border-left: 6px solid #d63384;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
    transition: 0.3s;
}

.project:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(142, 68, 173, 0.2);
}

.project h3 {
    color: #d63384;
    margin-bottom: 8px;
}

/* ทักษะ */
#skills {
    background: white;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
}

#skills ul {
    list-style: none;
    max-width: 600px;
    margin: auto;
}

#skills li {
    background: #f3e8ff;
    color: #6c3483;
    margin: 12px 0;
    padding: 12px 18px;
    border-radius: 12px;
    font-weight: bold;
    transition: 0.3s;
}

#skills li:hover {
    background: #e8d5ff;
    transform: translateX(8px);
}

/* ส่วนท้าย */
footer {
    background: #2c1638;
    color: white;
    text-align: center;
    padding: 30px 20px;
    margin-top: 50px;
}

footer p {
    margin: 5px 0;
}

footer a {
    color: #ff9bd2;
    text-decoration: none;
}

footer a:hover {
    text-decoration: underline;
}

/* รองรับมือถือ */
@media (max-width: 600px) {
    header {
        padding: 50px 15px;
    }

    header h1 {
        font-size: 28px;
    }

    header p {
        font-size: 16px;
    }

    section {
        margin: 25px auto;
        padding: 20px;
    }

    h2 {
        font-size: 25px;
    }

    #about p {
        font-size: 16px;
    }
}
